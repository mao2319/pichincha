# Production Environment Variables
# Copy this file to .env.production and fill in with real values for local testing
# For production deployment, configure these in Vercel Project Settings instead

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_here

# Claude API Configuration
VITE_ANTHROPIC_API_KEY=apikey_your_key_here

# Application Configuration
VITE_APP_ENV=production
VITE_APP_NAME=Pichincha AI Onboarding
VITE_LOG_LEVEL=info
